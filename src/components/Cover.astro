---
// A text's cover image, or a flat panel in the tradition's colour with an emblem.
import Icon from './Icon.astro';

interface Props {
	tradition?: string;
	image?: string;
	book?: boolean;
	framed?: boolean;
}
const { tradition, image, book = false, framed = false } = Astro.props;

const hues: Record<string, string> = {
	'Тхеравада': '#c4870f',
	'Махаяна': '#7b2232',
	'Ваджраяна': '#1f3a64',
	'Дзен': '#006176',
	'Тибетски будизъм': '#7b2232',
};
const hue = (tradition && hues[tradition]) || '#5a4a3f';
---
<div class:list={['cover', { 'cover-book': book && image, 'cover-framed': framed && image }]} style={`--hue: ${hue}${book && image ? `; --img: url("${image}")` : ''}`}>
	{image ? <img src={image} alt="" loading="lazy" /> : <Icon name="wheel" size={64} />}
</div>
