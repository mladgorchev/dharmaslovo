---
import Base from '../../layouts/Base.astro';
import Story from '../../components/Story.astro';
import { excerptOf, getTerms, getTranslations, slugify, termUrl } from '../../lib/utils';

export async function getStaticPaths() {
	const translations = await getTranslations();
	const terms = await getTerms();
	const tags = new Set([...translations, ...terms].flatMap((t) => t.data.tags));
	return [...tags].map((tag) => ({
		params: { tag: slugify(tag) },
		props: {
			tag,
			entries: translations.filter((t) => t.data.tags.includes(tag)),
			terms: terms.filter((t) => t.data.tags.includes(tag)),
		},
	}));
}

const { tag, entries, terms } = Astro.props;
const total = entries.length + terms.length;
---
<Base title={tag}>
	<div class="wrap">
		<header class="page-head panel">
			<a class="kicker" href="/temi/">Теми</a>
			<h1>{tag}</h1>
			<p>{total} {total === 1 ? 'текст' : 'текста'} по тази тема.</p>
		</header>
		{entries.length > 0 && (
			<div class="rows" style="margin-top:20px">{entries.map((entry) => <Story entry={entry} variant="row" />)}</div>
		)}
		{terms.length > 0 && (
			<ul class="term-list panel home-terms" style="margin-top:20px">
				{terms.map((t) => (
					<li>
						<a href={termUrl(t)}>
							<strong>{t.data.title}</strong>
							<span>{excerptOf(t, 140)}</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</div>
</Base>
